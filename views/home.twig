{% extends "base.twig" %}

{% block content %}
    {% set facetwp_enabled = recipes.facetwp_available|default(false) %}
    {% set facetwp_prefix = recipes.facetwp_prefix|default('g4t_') %}
    {% set current_url = fn('go4taste_recipes_theme_current_url') %}
    <section class="home-hero" aria-labelledby="home-hero-title">
        <div class="home-hero__inner site-container">
            <div class="home-hero__identity">
                <p class="home-hero__eyebrow">Go4Taste Przepisy</p>
                <h1 id="home-hero-title" class="home-hero__title">Gotuj z naturalnych składników</h1>
                <p class="home-hero__lead">Sprawdzone przepisy krok po kroku z orzechami, kaszami, bakaliami i przyprawami. Wybierz kategorię albo zacznij od najnowszej inspiracji.</p>

                {% if recipe_home.active_filter_tags is not empty %}
                    <nav class="home-hero__chips" aria-label="Aktualnie wybrane filtry">
                        {% for tag in recipe_home.active_filter_tags %}
                            {% if tag.url %}
                                <a class="home-chip" href="{{ tag.url|e('esc_url') }}" title="Przepisy z {{ tag.name }}">
                                    {{ tag.name }}
                                </a>
                            {% else %}
                                <span class="home-chip">{{ tag.name }}</span>
                            {% endif %}
                        {% endfor %}
                    </nav>
                {% endif %}

                <div class="home-hero__cta-row">
                    <a class="home-cta home-cta--primary" href="#przepisy">Przeglądaj przepisy</a>
                    {% if recipe_home.latest_recipe_url|default('') %}
                        <a class="home-cta home-cta--ghost" href="{{ recipe_home.latest_recipe_url|e('esc_url') }}">Zobacz nowy przepis</a>
                    {% endif %}
                </div>
            </div>

            <aside class="home-hero__feature" aria-label="Wyróżniony przepis">
                {% set featured = posts|length ? posts|first : null %}
                {% if featured and featured.thumbnail %}
                    <img src="{{ featured.thumbnail.src|e('esc_url') }}" alt="{{ featured.title }}" loading="eager">
                {% endif %}
                <h2>{{ featured ? featured.title : 'Wyróżniony przepis' }}</h2>
                <p>{{ featured ? featured.preview.length(15).read_more('') : 'Nowe inspiracje z kuchni Go4Taste.' }}</p>
                {% if featured %}
                    <a class="home-hero__feature-link" href="{{ featured.link|e('esc_url') }}">Przejdź do przepisu</a>
                {% endif %}
            </aside>
        </div>
    </section>

    <section id="przepisy" class="home-section home-section--recipes site-container recipe-listing-shell"
        aria-labelledby="przepisy-title"
        data-facetwp-enabled="{{ facetwp_enabled ? 'true' : 'false' }}"
        data-base-url="{{ fn('home_url', '/')|e('esc_url') }}"
        data-current-url="{{ current_url|e('esc_url') }}"
        data-facetwp-prefix="{{ facetwp_prefix|e('html_attr') }}">
        <div class="home-section__head">
            <p class="home-section__eyebrow">Inspiracje</p>
            <h2 id="przepisy-title">Najnowsze przepisy</h2>
        </div>

        <ul class="home-recipe-grid facetwp-template">
            {% for post_item in posts|slice(0, 10) %}
                <li class="home-recipe-card">
                    <a href="{{ post_item.link|e('esc_url') }}">
                        {% if post_item.thumbnail %}
                            <img src="{{ post_item.thumbnail.src|e('esc_url') }}" alt="{{ post_item.title }}" loading="lazy">
                        {% endif %}
                        <div class="home-recipe-card__body">
                            <h3>{{ post_item.title }}</h3>
                            <p>{{ post_item.preview.length(18).read_more('') }}</p>
                            {% set difficulty_raw = post_item.meta('recipe_difficulty')|default('Latwy')|lower %}
                            {% set difficulty_label = difficulty_raw in ['easy', 'latwy', 'łatwy']
                                ? 'Łatwy'
                                : (difficulty_raw in ['medium', 'sredni', 'średni']
                                    ? 'Średni'
                                    : (difficulty_raw in ['hard', 'trudny'] ? 'Trudny' : post_item.meta('recipe_difficulty')|default('Latwy'))) %}
                            <span>{{ post_item.meta('recipe_time_total')|default('35 min') }} • {{ difficulty_label }}</span>
                        </div>
                    </a>
                </li>
            {% else %}
                <li class="home-recipe-card">
                    <div class="home-recipe-card__body">
                        <h3>Brak przepisów</h3>
                        <p>Dodaj pierwszy przepis, aby uzupełnić stronę główną.</p>
                    </div>
                </li>
            {% endfor %}
        </ul>

        {% if posts.pagination.pages is not empty %}
            <nav class="archive-pagination" aria-label="Nawigacja stron listy przepisów">
                {% for page in posts.pagination.pages %}
                    {% if page.link %}
                        <a class="archive-pagination__item" href="{{ page.link|e('esc_url') }}">{{ page.title }}</a>
                    {% else %}
                        <a class="archive-pagination__item is-active" href="#" aria-current="page">{{ page.title }}</a>
                    {% endif %}
                {% endfor %}
            </nav>
        {% endif %}
    </section>
{% endblock %}
