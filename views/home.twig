{% extends "base.twig" %}

{% block content %}
    <section class="home-hero" aria-labelledby="home-hero-title">
        <div class="home-hero__inner site-container">
            <div class="home-hero__identity">
                <p class="home-hero__eyebrow">Go4Taste Przepisy</p>
                <h1 id="home-hero-title" class="home-hero__title">Nowa strona glowna dla migracji przepisow</h1>
                <p class="home-hero__lead">Startowy widok, ktory prowadzi uzytkownika od kategorii i inspiracji do pojedynczego przepisu.</p>

                <div class="home-hero__cta-row">
                    <a class="home-cta home-cta--primary" href="#przepisy">Przegladaj przepisy</a>
                    <a class="home-cta home-cta--ghost" href="{{ site.url }}">Zobacz nowy przepis</a>
                </div>
            </div>

            <aside class="home-hero__feature" aria-label="Wyrozniony przepis">
                {% set featured = posts|length ? posts|first : null %}
                {% if featured and featured.thumbnail %}
                    <img src="{{ featured.thumbnail.src|e('esc_url') }}" alt="{{ featured.title }}" loading="eager">
                {% endif %}
                <h2>{{ featured ? featured.title : 'Wyrozniony przepis' }}</h2>
                <p>{{ featured ? featured.preview.length(15).read_more('') : 'Nowe inspiracje z kuchni Go4Taste.' }}</p>
                {% if featured %}
                    <a class="home-hero__feature-link" href="{{ featured.link|e('esc_url') }}">Przejdz do przepisu</a>
                {% endif %}
            </aside>
        </div>
    </section>

    <section id="przepisy" class="home-section home-section--recipes site-container" aria-labelledby="przepisy-title">
        <div class="home-section__head">
            <p class="home-section__eyebrow">Inspiracje</p>
            <h2 id="przepisy-title">Najnowsze przepisy</h2>
        </div>

        <ul class="home-recipe-grid">
            {% for post_item in posts %}
                <li class="home-recipe-card">
                    <a href="{{ post_item.link|e('esc_url') }}">
                        {% if post_item.thumbnail %}
                            <img src="{{ post_item.thumbnail.src|e('esc_url') }}" alt="{{ post_item.title }}" loading="lazy">
                        {% endif %}
                        <div class="home-recipe-card__body">
                            <h3>{{ post_item.title }}</h3>
                            <p>{{ post_item.preview.length(18).read_more('') }}</p>
                            <span>{{ post_item.meta('recipe_time_total')|default('35 min') }} • {{ post_item.meta('recipe_difficulty')|default('Latwy') }}</span>
                        </div>
                    </a>
                </li>
            {% else %}
                <li class="home-recipe-card">
                    <div class="home-recipe-card__body">
                        <h3>Brak przepisow</h3>
                        <p>Dodaj pierwszy przepis, aby uzupelnic strone glowna.</p>
                    </div>
                </li>
            {% endfor %}
        </ul>

        {% if posts.pagination.pages is not empty %}
            <nav class="archive-pagination" aria-label="Nawigacja stron listy przepisow">
                {% for page in posts.pagination.pages %}
                    {% if page.link %}
                        <a class="archive-pagination__item" href="{{ page.link|e('esc_url') }}">{{ page.title }}</a>
                    {% else %}
                        <a class="archive-pagination__item is-active" href="#" aria-current="page">{{ page.title }}</a>
                    {% endif %}
                {% endfor %}
            </nav>
        {% endif %}
    </section>
{% endblock %}
